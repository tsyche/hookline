#!/usr/bin/env python3
"""hookline daemon — receives ntfy phone responses via SSE and routes them.

Maintains a persistent SSE connection so phone responses arrive instantly.
For tmux sessions: injects keystrokes directly (no accessibility needed).
For all others: writes a response file that the hook process reads and acts on,
keeping keystroke injection in the hook's process tree (already trusted by macOS).
"""

import base64
import json
import logging
import logging.handlers
import os
import re
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.request
import urllib.error

SOCKET_PATH   = os.path.expanduser("~/.local/share/hookline/daemon.sock")
PID_PATH      = os.path.expanduser("~/.local/share/hookline/daemon.pid")
LOG_PATH      = os.path.expanduser("~/.local/share/hookline/daemon.log")
CONFIG_PATH   = os.path.expanduser("~/.config/hookline/config")
THROTTLE_PATH = os.path.expanduser("~/.local/share/hookline/ntfy-throttle")
SNOOZE_PATH   = os.path.expanduser("~/.local/share/hookline/snooze")
HEARTBEAT_PATH     = os.path.expanduser("~/.local/share/hookline/heartbeat")
SSE_HEARTBEAT_PATH = os.path.expanduser("~/.local/share/hookline/sse-heartbeat")

# Bounds a silently-dead SSE stream: a read that never returns raises at this
# timeout and forces a reconnect (which re-touches the SSE heartbeat). Healthy
# idle connections reconnect on the same cadence — cheap — while a frozen
# urllib read leaves the heartbeat stale so the watchdog can restart us.
SSE_READ_TIMEOUT = 300

# Bare replies accepted from the main topic (typed in the ntfy app): short
# alnum only — option numbers/letters ("4"/"D"), retry/allow/deny/snooze/
# unsnooze/context words, and misses like "two" that get routed to
# invalid-reply feedback. The one spaced form allowed is "snooze <minutes>";
# any other multi-char body with spaces/punctuation is our own notification
# echo — never parsed as decision.
TYPED_REPLY_RE = re.compile(r'^(?:[0-9A-Za-z]{1,12}|snooze [0-9]{1,4})$')


# ── snooze ────────────────────────────────────────────────────────────────────
# Phone-notification mute window set by `hookline snooze N` or a typed
# "snooze [minutes]" reply. The file holds a future unix epoch; every send
# path checks it (here in send_ntfy, and again in the hook's watcher before
# it hands a notify to the daemon). The terminal prompt is never affected.

def snooze_active(path=None):
    try:
        with open(path or SNOOZE_PATH) as f:
            return int(f.read().strip()) > int(time.time())
    except (OSError, ValueError):
        return False


def set_snooze(minutes, path=None):
    path = path or SNOOZE_PATH
    exp = int(time.time()) + minutes * 60
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        f.write(str(exp))
    return exp


def clear_snooze(path=None):
    try:
        os.remove(path or SNOOZE_PATH)
    except FileNotFoundError:
        pass

# ── context keyword ───────────────────────────────────────────────────────────
# Typed "context" from the ntfy app while a prompt pends: the daemon reads the
# session's transcript tail and asks the provider's own headless CLI for an
# assessed summary, pushed as a NEW notification (force=True — an explicit
# user request bypasses snooze; ≤10 lines). The pending prompt, its options,
# and its response file are never touched. Any failure — no transcript,
# missing binary, timeout, empty output — falls back to the raw tail (the
# last 10 lines, newest first-hand data).

CONTEXT_PROMPT = (
    "Summarize where this coding-agent conversation stands for someone who is "
    "away from the terminal and about to answer a pending approval prompt on "
    "their phone. At most 10 short lines: the current task, what just "
    "happened, and what the pending prompt is asking for. Plain text only — "
    "no markdown, no preamble, no tool use.\n\nTranscript tail:\n"
)
CONTEXT_MAX_LINES      = 10
CONTEXT_TAIL_LINES     = 200
CONTEXT_TAIL_BYTES     = 8 * 1024
CONTEXT_LINE_CHARS     = 400   # transcript JSONL lines can be tens of KB
CONTEXT_BUDGET         = 1500  # same body budget as question rendering
CONTEXT_DEFAULT_TIMEOUT = 45


def _find_bin(name):
    """Absolute path for a CLI — launchd gives the daemon a minimal PATH."""
    import shutil
    found = shutil.which(name)
    if found:
        return found
    for d in ("/opt/homebrew/bin", "/usr/local/bin",
              os.path.expanduser("~/.local/bin")):
        p = os.path.join(d, name)
        if os.path.exists(p):
            return p
    return None


def transcript_tail(path):
    """Last CONTEXT_TAIL_LINES lines / 8KB of a transcript file ('' on error)."""
    try:
        with open(path, 'rb') as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - CONTEXT_TAIL_BYTES))
            data = f.read().decode('utf-8', errors='replace')
    except OSError:
        return ''
    return '\n'.join(data.splitlines()[-CONTEXT_TAIL_LINES:]).strip()


def opencode_export_tail(session_id, timeout=30):
    """opencode keeps no transcript file — a read-only `opencode export`
    yields role-tagged text of the last messages ('' on any failure)."""
    binary = _find_bin('opencode')
    if not binary:
        return ''
    try:
        r = subprocess.run([binary, 'export', '--pure', session_id],
                           capture_output=True, text=True, timeout=timeout)
    except Exception:
        return ''
    if r.returncode != 0:
        return ''
    try:
        data = json.loads(r.stdout)
    except (ValueError, TypeError):
        return ''
    out = []
    for m in (data.get('messages') or [])[-40:]:
        role = (m.get('info') or {}).get('role') or '?'
        text = ' '.join(str(p.get('text') or '')
                        for p in (m.get('parts') or [])
                        if p.get('type') == 'text')
        if text.strip():
            out.append(f"{role}: {text[:600]}")
    return '\n'.join(out)


def headless_summary(provider, transcript, cwd, timeout):
    """Provider's headless CLI over the transcript tail → text, or None.

    HOOKLINE_CONTEXT_CHILD rides along so the summarizer's own tool calls hit
    the entry guard instead of starting a second phone flow. blackbox is a
    claude profile and rides `claude -p`.
    """
    binary_name = {'claude': 'claude', 'blackbox': 'claude', 'codex': 'codex',
                   'grok': 'grok', 'opencode': 'opencode'}.get(provider)
    if not binary_name:
        return None
    binary = _find_bin(binary_name)
    if not binary:
        return None
    prompt = CONTEXT_PROMPT + transcript
    if provider == 'codex':
        cmd = [binary, 'exec', '--skip-git-repo-check', '-s', 'read-only',
               '--color', 'never', '-']
    elif provider == 'opencode':
        cmd = [binary, 'run', '--pure', '--title', 'hookline context', prompt]
    elif provider == 'grok':
        cmd = [binary, '-p', prompt]
    else:
        cmd = [binary, '-p', prompt]
    kwargs = dict(capture_output=True, text=True, timeout=timeout,
                  cwd=cwd if cwd and os.path.isdir(cwd)
                     else os.path.expanduser('~'),
                  env=dict(os.environ, HOOKLINE_CONTEXT_CHILD='1'))
    if cmd[-1] == '-':
        kwargs['input'] = prompt      # codex reads the prompt from stdin
    else:
        kwargs['stdin'] = subprocess.DEVNULL
    try:
        r = subprocess.run(cmd, **kwargs)
    except (subprocess.TimeoutExpired, OSError):
        return None
    if r.returncode != 0 or not r.stdout.strip():
        return None
    return r.stdout


def fit_context(text, keep='first'):
    """≤CONTEXT_MAX_LINES lines, ANSI stripped, per-line + total budget."""
    text = re.sub(r'\x1b\[[0-9;?]*[A-Za-z]', '', text or '')
    lines = [l.rstrip()[:CONTEXT_LINE_CHARS]
             for l in text.splitlines() if l.strip()]
    lines = lines[:CONTEXT_MAX_LINES] if keep == 'first' \
        else lines[-CONTEXT_MAX_LINES:]
    out = '\n'.join(lines)
    if len(out) > CONTEXT_BUDGET:
        out = out[:CONTEXT_BUDGET - 3] + '...'
    return out


# daemon.log is append-only and used to grow forever (plus the launchd plist
# points stdout/stderr at it). Cap it: one rotated backup, then overwrite.
LOG_MAX_BYTES   = 512 * 1024
LOG_BACKUP_COUNT = 1


def touch(path):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w') as f:
            f.write(str(time.time()))
    except OSError:
        pass


def age(path):
    """Seconds since path was last written, or -1 when missing."""
    try:
        return int(time.time() - os.path.getmtime(path))
    except OSError:
        return -1


def _find_tmux():
    """launchd gives us a minimal PATH (no /usr/local/bin), so a bare 'tmux'
    fails with FileNotFoundError and phone taps never dismiss the prompt.
    Resolve an absolute path, checking PATH first then the usual install dirs."""
    import shutil
    found = shutil.which("tmux")
    if found:
        return found
    for candidate in ("/usr/local/bin/tmux", "/opt/homebrew/bin/tmux", "/usr/bin/tmux"):
        if os.path.exists(candidate):
            return candidate
    return "tmux"  # last resort — will error, but logged


TMUX_BIN = _find_tmux()


def load_config():
    config = {}
    try:
        with open(CONFIG_PATH) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#') and '=' in line:
                    key, _, val = line.partition('=')
                    config[key.strip()] = val.strip().strip('"\'')
    except FileNotFoundError:
        pass
    return config


class Daemon:
    def __init__(self):
        # Rotating handler on this logger only (not root/basicConfig) so the
        # unit tests can instantiate Daemon repeatedly without stacking
        # handlers. propagate=False keeps root from double-writing.
        self.log = logging.getLogger('hookline')
        if not self.log.handlers:
            handler = logging.handlers.RotatingFileHandler(
                LOG_PATH, maxBytes=LOG_MAX_BYTES, backupCount=LOG_BACKUP_COUNT,
            )
            handler.setFormatter(logging.Formatter(
                '[%(asctime)s] %(message)s', datefmt='%Y-%m-%d %H:%M:%S',
            ))
            self.log.addHandler(handler)
            self.log.setLevel(logging.INFO)
            self.log.propagate = False
        self.sessions = {}  # session_id → info dict
        self.pending  = {}  # req_id → session_id
        # req_id → option labels for single-select questions, so a typed
        # response-topic reply ("4" / "D") can map back to a label
        self.question_options = {}
        self.lock     = threading.Lock()
        self._stop    = threading.Event()

    # ── ntfy ──────────────────────────────────────────────────────────────────

    def _ntfy_headers(self, config):
        headers = {'Content-Type': 'application/json'}
        user = config.get('HOOKLINE_NTFY_USERNAME', '')
        if user:
            creds = base64.b64encode(
                f"{user}:{config.get('HOOKLINE_NTFY_PASSWORD','')}".encode()
            ).decode()
            headers['Authorization'] = f'Basic {creds}'
        return headers

    def _throttle(self):
        try:
            last = float(open(THROTTLE_PATH).read().strip())
        except Exception:
            last = 0
        wait = 5 - (time.time() - last)
        if wait > 0:
            time.sleep(wait)
        with open(THROTTLE_PATH, 'w') as f:
            f.write(str(time.time()))

    def send_ntfy(self, config, title, message, req_id, actions=None,
                  force=False):
        # force = snooze confirmations/resume notices, which must go out
        # even while a window is (being) active.
        if not force and snooze_active():
            self.log.info(f"[{req_id[:16]}] snoozed, skipping phone notification")
            return False
        self._throttle()
        topic      = config.get('HOOKLINE_TOPIC', '')
        server     = config.get('HOOKLINE_NTFY_SERVER', 'https://ntfy.sh').rstrip('/')
        resp_topic = f"{topic}-response"
        # Custom actions (question-dialog options): each {label, payload} posts
        # "<payload>|<req_id>" to the response topic — the SSE parser's
        # rsplit('|', 1) keeps "answer|<label>" as the decision. ntfy caps
        # actions at 3; default trio when actions is None (nothing supplied).
        # An explicit empty list means "no buttons" (notify-only question).
        if actions is None:
            ntfy_actions = [
                {'action':'http','label':'Allow','url':f"{server}/{resp_topic}",'method':'POST','body':f"allow|{req_id}"},
                {'action':'http','label':'Deny', 'url':f"{server}/{resp_topic}",'method':'POST','body':f"deny|{req_id}"},
                {'action':'http','label':'Retry','url':f"{server}/{resp_topic}",'method':'POST','body':f"retry|{req_id}"},
            ]
        else:
            ntfy_actions = [
                {'action': 'http', 'label': a.get('label', '?'),
                 'url': f"{server}/{resp_topic}", 'method': 'POST',
                 'body': f"{a.get('payload', '')}|{req_id}"}
                for a in actions
            ]
        payload = json.dumps({
            'topic': topic, 'title': title, 'message': message,
            'priority': 4, 'tags': ['lock'],
            'actions': ntfy_actions,
        }).encode()
        req = urllib.request.Request(
            f"{server}/", data=payload, headers=self._ntfy_headers(config), method='POST'
        )
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                result = json.loads(resp.read())
                self.log.info(f"[{req_id[:16]}] notification sent id={result.get('id','?')}")
                return True
        except Exception as e:
            self.log.error(f"[{req_id[:16]}] failed to send: {e}")
            return False

    # ── SSE listener ───────────────────────────────────────────────────────────

    def sse_listener(self, suffix="-response"):
        # Log state changes only: the first connect, the first failure of an
        # error streak, and the recovery after one. Routine idle recycles
        # (SSE_READ_TIMEOUT with a healthy server) are silent — they used to
        # write two lines every ~5 min and grow daemon.log without bound.
        # Two listeners run: "-response" (button-tap HTTP actions, full body
        # parsing) and the bare topic "" (typed replies from the ntfy app land
        # on the topic the notification came from) — bare-only there, so our
        # own echoed notifications never hit the decision parser.
        bare_only = (suffix == "")
        announce = True       # next successful connect is a state change
        streak_logged = False # first failure of the current streak
        while not self._stop.is_set():
            try:
                config = load_config()
                topic  = config.get('HOOKLINE_TOPIC', '')
                server = config.get('HOOKLINE_NTFY_SERVER', 'https://ntfy.sh').rstrip('/')
                url    = f"{server}/{topic}{suffix}/json"
                req = urllib.request.Request(url, headers=self._ntfy_headers(config))
                with urllib.request.urlopen(req, timeout=SSE_READ_TIMEOUT) as resp:
                    if announce:
                        self.log.info(f"SSE connected to {url}")
                        announce = False
                    streak_logged = False
                    touch(SSE_HEARTBEAT_PATH)
                    for raw in resp:
                        if self._stop.is_set():
                            return
                        touch(SSE_HEARTBEAT_PATH)
                        line = raw.decode('utf-8').strip()
                        if not line:
                            continue
                        try:
                            msg  = json.loads(line)
                            body = msg.get('message', '')
                            if '|' in body and not bare_only:
                                decision, req_id = body.rsplit('|', 1)
                                threading.Thread(
                                    target=self.handle_response,
                                    args=(req_id.strip(), decision.strip()),
                                    daemon=True,
                                ).start()
                            elif TYPED_REPLY_RE.match(body.strip()):
                                # bare typed reply: option number/letter
                                # ("4"/"D") or a word ("retry"/"deny"/"allow")
                                # — alnum-only and short so echoed
                                # notification bodies never reach the resolver
                                threading.Thread(
                                    target=self.handle_typed_reply,
                                    args=(body.strip(),),
                                    daemon=True,
                                ).start()
                        except json.JSONDecodeError:
                            pass
            except (socket.timeout, TimeoutError):
                # Routine idle recycle after SSE_READ_TIMEOUT — expected
                # cadence, not a state change. Reconnect silently.
                pass
            except Exception as e:
                if not streak_logged:
                    self.log.warning(f"SSE lost on {topic}{suffix} ({e}), reconnecting in 5s")
                    streak_logged = True
                announce = True
                time.sleep(5)

    # ── response routing ───────────────────────────────────────────────────────

    def handle_typed_reply(self, text):
        """Bare reply from the ntfy app: number/letter option, or word.

        Words: "retry"/"deny" route to any single pending prompt (question
        reject works the same as permission deny); "allow" only fits
        permission prompts — on a question it gets invalid-reply feedback.
        Option pick: resolves to answer|<label> only when exactly one
        question with an option list is pending. Anything else that looks
        like an attempt (exactly one question pending) pushes a feedback
        notification with Retry/Deny buttons; ambiguous replies are logged
        and dropped.
        """
        low = text.lower()

        # 'context' is a read-only side request: summarize the transcript on
        # a new notification without resolving the prompt.
        if low == 'context':
            self._handle_context()
            return

        # Snooze controls run before anything prompt-shaped: they never
        # resolve a pending prompt, they only flip the mute window.
        if low in ('snooze', 'unsnooze') or low.startswith('snooze '):
            if low == 'unsnooze':
                self._handle_unsnooze()
            else:
                self._handle_snooze_reply(low)
            return

        if low in ('allow', 'deny', 'retry'):
            with self.lock:
                pend = list(self.pending)
            if len(pend) != 1:
                self.log.info(
                    f"word reply {low!r}: {len(pend)} prompt(s) pending, ignoring"
                )
                return
            req_id = pend[0]
            if low == 'allow':
                with self.lock:
                    is_question = req_id in self.question_options
                if is_question:
                    with self.lock:
                        options = list(self.question_options.get(req_id, []))
                    self._invalid_reply(req_id, text, options)
                    return
                self.handle_response(req_id, 'allow')
            else:
                self.handle_response(req_id, low)
            return

        with self.lock:
            candidates = [r for r in self.question_options if r in self.pending]
        if len(candidates) != 1:
            self.log.info(
                f"typed reply {text!r}: {len(candidates)} question(s) with "
                "options pending, ignoring"
            )
            return
        req_id = candidates[0]
        with self.lock:
            options = list(self.question_options.get(req_id, []))
        label = None
        if len(text) == 1:
            if text.isdigit():
                idx = int(text) - 1
            elif text.isalpha() and text.isascii():
                idx = ord(text.lower()) - ord('a')
            else:
                idx = -1
            if 0 <= idx < len(options):
                label = options[idx]
        if label is None:
            self.log.info(
                f"[{req_id[:16]}] typed reply {text!r} not in "
                f"1-{len(options)}, invalid reply"
            )
            if text:   # empty body is not an attempt — nothing to correct
                self._invalid_reply(req_id, text, options)
            return
        self.handle_response(req_id, f"answer|{label}")

    def _invalid_reply(self, req_id, text, options):
        """Push a correction notification for a reply that didn't resolve.

        Keeps the question pending — Retry re-notifies, Deny rejects.
        """
        with self.lock:
            session_id = self.pending.get(req_id, '')
            session = dict(self.sessions.get(session_id, {}))
            title = session.get('notify_title', 'hookline')
            header = session.get('alert_header') or ''
        n = len(options)
        if n <= 0:
            return
        hint = f"1-{n}"
        if n <= 26:
            hint += f" (or A-{chr(ord('A') + n - 1)})"
        body = (f"'{text}' is not a valid answer for this question.\n"
                f"Reply {hint}, retry, or deny.")
        if header:
            body = header + "\n\n" + body
        self.send_ntfy(
            load_config(),
            f"{title} — invalid reply",
            body,
            req_id,
            actions=[
                {'label': 'Retry', 'payload': 'retry'},
                {'label': 'Deny',  'payload': 'deny'},
            ],
        )

    def _handle_snooze_reply(self, text):
        """Typed 'snooze [minutes]': open a mute window, confirm on the phone."""
        minutes = 60
        parts = text.split()
        if len(parts) > 1:
            try:
                minutes = int(parts[1])
            except ValueError:
                minutes = -1
        if not 1 <= minutes <= 10080:
            self.send_ntfy(load_config(), 'hookline',
                           'Snooze: minutes must be 1-10080', '', [], force=True)
            return
        exp = set_snooze(minutes)
        self.log.info(f"snoozed {minutes}m until {exp}")
        self.send_ntfy(
            load_config(), 'hookline',
            f'Phone notifications snoozed for {minutes}m '
            f'(until {time.strftime("%H:%M", time.localtime(exp))})',
            '', [{'label': 'Unsnooze', 'payload': 'unsnooze'}], force=True)

    def _handle_unsnooze(self):
        """Typed or tapped 'unsnooze': clear the mute window, confirm."""
        clear_snooze()
        self.log.info('snooze cleared')
        self.send_ntfy(load_config(), 'hookline', 'Notifications resumed',
                       '', [], force=True)

    def _context_transcript(self, session, session_id):
        """Transcript source for a summary: the registered file tail, or a
        read-only opencode export (opencode has no transcript file)."""
        path = session.get('transcript_path') or ''
        if path and os.path.isfile(path):
            return transcript_tail(path)
        if session.get('provider') == 'opencode':
            return opencode_export_tail(session_id)
        return ''

    def _handle_context(self):
        """Typed 'context': assessed transcript summary on a side notification.

        Read-only for the prompt — pending, question options, and the
        response file stay exactly as they were, so the original prompt is
        still answerable by button or typed reply afterwards. The most
        recently notified pending prompt wins when several are in flight.
        """
        config = load_config()
        with self.lock:
            req_ids = list(self.pending)
        if not req_ids:
            self.log.info('context: no pending prompt')
            self.send_ntfy(config, 'hookline',
                           'No pending prompt — nothing to summarize', '',
                           [], force=True)
            return
        req_id = req_ids[-1]
        with self.lock:
            session_id = self.pending[req_id]
            session = dict(self.sessions.get(session_id, {}))
        provider = session.get('provider', '')
        self.log.info(
            f"[{req_id[:16]}] context request (session {session_id[:8]} "
            f"provider={provider or '?'})"
        )
        transcript = self._context_transcript(session, session_id)
        if not transcript:
            summary = ('No transcript available for this session — '
                       'nothing to summarize.')
        else:
            try:
                timeout = int(config.get('HOOKLINE_CONTEXT_TIMEOUT',
                                         CONTEXT_DEFAULT_TIMEOUT))
            except ValueError:
                timeout = CONTEXT_DEFAULT_TIMEOUT
            summary = headless_summary(provider, transcript,
                                        session.get('cwd', ''), timeout)
            # model answer → its first lines; raw-tail fallback → the LAST
            # lines (newest first-hand data).
            summary = fit_context(summary or transcript,
                                  keep='first' if summary else 'last')
        title = session.get('notify_title') or 'hookline'
        header = session.get('alert_header') or ''
        if header:
            summary = header + "\n\n" + summary
        self.send_ntfy(config, f'{title} — context', summary, req_id, [],
                       force=True)

    def handle_response(self, req_id, decision):
        # Unsnooze button lands here: response-topic body "unsnooze|" →
        # decision 'unsnooze', empty req_id — before any pending lookup.
        if decision == 'unsnooze':
            self._handle_unsnooze()
            return
        with self.lock:
            session_id = self.pending.get(req_id)
        if not session_id:
            with self.lock:
                self.question_options.pop(req_id, None)
            self.log.info(f"[{req_id[:16]}] unknown req_id, ignoring")
            return
        with self.lock:
            session = dict(self.sessions.get(session_id, {}))
        self.log.info(f"[{req_id[:16]}] phone: {decision}")

        tmux_pane     = session.get('tmux_pane', '')
        tmux_socket   = session.get('tmux_socket', '')
        response_file = session.get('response_file', '')

        if decision in ('allow', 'deny'):
            if tmux_pane:
                # tmux injection needs no accessibility permissions.
                # allow → "1" + Enter (option 1 is always Yes).
                # deny  → Escape, which cancels the prompt regardless of how many
                #         options the menu has ("3" breaks on 2-option menus).
                if decision == 'allow':
                    keys = ['1', 'Enter']
                else:
                    keys = ['Escape']
                # launchd has no TMUX_TMPDIR; -S pins the client's socket so
                # send-keys reaches the real server instead of an empty default.
                sock_args = ['-S', tmux_socket] if tmux_socket else []
                self.log.info(
                    f"inject {decision} via tmux pane {tmux_pane} ({TMUX_BIN})"
                    + (f" socket={tmux_socket}" if tmux_socket else "")
                )
                result = subprocess.run(
                    [TMUX_BIN] + sock_args + ['send-keys', '-t', tmux_pane] + keys,
                    capture_output=True,
                )
                if result.returncode != 0:
                    self.log.error(
                        f"tmux inject failed (rc={result.returncode}): "
                        f"{result.stderr.decode(errors='replace').strip()}"
                    )
            else:
                # Write response file; hook process (child of terminal) injects
                self._write_response(response_file, decision)
            with self.lock:
                self.pending.pop(req_id, None)
                self.question_options.pop(req_id, None)

        elif decision.startswith('answer|'):
            # Question-dialog option (tap or typed reply): claude/other
            # tmux sessions get the option's number + Enter in the exact pane
            # (the picker accepts number keys); response-only sessions (the
            # opencode plugin bridge) get the response file and the hook's
            # background process relays it over the bridge.
            label = decision[7:]
            options = self.question_options.get(req_id, [])
            idx = options.index(label) + 1 if label in options else 0
            if tmux_pane and idx:
                sock_args = ['-S', tmux_socket] if tmux_socket else []
                self.log.info(
                    f"inject answer {idx} ({label}) via tmux pane {tmux_pane} ({TMUX_BIN})"
                    + (f" socket={tmux_socket}" if tmux_socket else "")
                )
                result = subprocess.run(
                    [TMUX_BIN] + sock_args + ['send-keys', '-t', tmux_pane, str(idx), 'Enter'],
                    capture_output=True,
                )
                if result.returncode != 0:
                    self.log.error(
                        f"tmux inject failed (rc={result.returncode}): "
                        f"{result.stderr.decode(errors='replace').strip()}"
                    )
            else:
                self._write_response(response_file, decision)
            with self.lock:
                self.pending.pop(req_id, None)
                self.question_options.pop(req_id, None)

        elif decision == 'retry':
            # Tell hook to resend — it controls retry count
            self._write_response(response_file, 'retry')
            with self.lock:
                self.pending.pop(req_id, None)
                self.question_options.pop(req_id, None)

    def _write_response(self, response_file, decision):
        if not response_file:
            return
        try:
            # 0600 on create: the file carries an approval decision and may be
            # recreated by each retry round (the hook deletes between rounds).
            fd = os.open(response_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, 'w') as f:
                f.write(decision)
        except Exception as e:
            self.log.error(f"failed to write response file: {e}")

    # ── socket server ─────────────────────────────────────────────────────────

    def handle_notify(self, msg):
        session_id    = msg['session_id']
        req_id        = msg['req_id']
        title         = msg.get('title', 'hookline')
        message       = msg.get('message', '')
        response_file = msg.get('response_file', '')
        max_retries   = int(msg.get('max_retries', 2))
        # no_actions (notify-only question) → explicit empty list: no buttons.
        # Permissions also send actions:[], so the flag, not the array, decides.
        if msg.get('no_actions'):
            actions = []
        else:
            actions = msg.get('actions') or None
        options   = msg.get('options') or []   # typed-reply label list (questions)

        config = load_config()
        with self.lock:
            for old_req in [r for r, s in self.pending.items() if s == session_id]:
                self.log.info(f"[{old_req[:16]}] superseded, cancelling")
                del self.pending[old_req]
                self.question_options.pop(old_req, None)
            self.pending[req_id] = session_id
            if options:
                self.question_options[req_id] = options
            sess = self.sessions.setdefault(session_id, {})
            sess.update({
                'notify_title':   title,
                'notify_message': message,
                'response_file':  response_file,
                'max_retries':    max_retries,
                'retry_count':    0,
            })

        self.send_ntfy(config, title, message, req_id, actions)

    def handle_connection(self, conn):
        try:
            data = b''
            while True:
                chunk = conn.recv(4096)
                if not chunk:
                    break
                data += chunk
            msg      = json.loads(data.decode())
            msg_type = msg.get('type')

            if msg_type == 'register':
                session_id = msg['session_id']
                with self.lock:
                    sess = self.sessions.setdefault(session_id, {})
                    sess.update({
                        'tty':             msg.get('tty', ''),
                        'term_program':    msg.get('term_program', ''),
                        'tmux_pane':       msg.get('tmux_pane', ''),
                        'tmux_socket':     msg.get('tmux_socket', ''),
                        # context-keyword inputs: headless binary choice,
                        # transcript source, working directory — plus the
                        # alert header line (project/branch/dir) so derived
                        # notifications carry the same identifying metadata
                        'provider':        msg.get('provider', ''),
                        'transcript_path': msg.get('transcript_path', ''),
                        'cwd':             msg.get('cwd', ''),
                        'alert_header':    msg.get('alert_header', ''),
                    })
                self.log.info(
                    f"registered session {session_id[:8]} "
                    f"tty={msg.get('tty','')} tmux={msg.get('tmux_pane','')} "
                    f"provider={msg.get('provider','')}"
                )
                conn.sendall(b'ok')

            elif msg_type == 'notify':
                conn.sendall(b'ok')
                conn.close()
                self.handle_notify(msg)
                return

            elif msg_type == 'cancel':
                req_id = msg.get('req_id', '')
                with self.lock:
                    self.pending.pop(req_id, None)
                    self.question_options.pop(req_id, None)
                self.log.info(f"[{req_id[:16]}] cancelled by hook")
                conn.sendall(b'ok')

            elif msg_type == 'status':
                with self.lock:
                    status = {
                        'pid':      os.getpid(),
                        'sessions': len(self.sessions),
                        'pending':  len(self.pending),
                    }
                status['heartbeat_age'] = age(HEARTBEAT_PATH)
                status['sse_age']       = age(SSE_HEARTBEAT_PATH)
                conn.sendall(json.dumps(status).encode())

            else:
                conn.sendall(b'unknown')
        except Exception as e:
            self.log.error(f"connection error: {e}")
        finally:
            conn.close()

    def serve(self):
        if os.path.exists(SOCKET_PATH):
            os.unlink(SOCKET_PATH)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(SOCKET_PATH)
        os.chmod(SOCKET_PATH, 0o600)
        server.listen(20)
        server.settimeout(1.0)
        self.log.info(f"listening on {SOCKET_PATH}")
        while not self._stop.is_set():
            touch(HEARTBEAT_PATH)
            try:
                conn, _ = server.accept()
                threading.Thread(
                    target=self.handle_connection, args=(conn,), daemon=True
                ).start()
            except socket.timeout:
                continue
            except Exception as e:
                self.log.error(f"socket error: {e}")
        server.close()
        if os.path.exists(SOCKET_PATH):
            os.unlink(SOCKET_PATH)

    # ── lifecycle ─────────────────────────────────────────────────────────────

    def start(self):
        with open(PID_PATH, 'w') as f:
            f.write(str(os.getpid()))

        def on_signal(sig, frame):
            self.log.info("shutting down")
            self._stop.set()

        signal.signal(signal.SIGTERM, on_signal)
        signal.signal(signal.SIGINT, on_signal)

        self.log.info(f"hookline daemon starting pid={os.getpid()} tmux={TMUX_BIN}")
        touch(HEARTBEAT_PATH)
        touch(SSE_HEARTBEAT_PATH)
        threading.Thread(target=self.sse_listener, args=("-response",), daemon=True).start()
        threading.Thread(target=self.sse_listener, args=("",), daemon=True).start()
        self.serve()

        if os.path.exists(PID_PATH):
            os.unlink(PID_PATH)
        self.log.info("daemon stopped")


if __name__ == '__main__':
    if len(sys.argv) < 2 or sys.argv[1] != 'start':
        print("usage: hookline-daemon start", file=sys.stderr)
        sys.exit(1)
    Daemon().start()
